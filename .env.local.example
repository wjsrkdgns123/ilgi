# Supabase 연결 정보
# Supabase 대시보드 → Settings → API 에서 복사
# 이 파일은 양식만 보여주는 예시. 실제 값은 .env.local 에 작성 (gitignore됨)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 프로덕션 사이트 URL (OG 메타/카논 URL용)
# 미설정 시 https://bbirong.vercel.app 기본값
NEXT_PUBLIC_SITE_URL=https://bbirong.vercel.app
